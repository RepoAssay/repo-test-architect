{
  "name": "repo-test-architect",
  "version": "0.2.0",
  "private": false,
  "mcpName": "io.github.RepoAssay/repo-test-architect",
  "description": "Audit-first test strategy agent for repository-native test planning.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repoassay/repo-test-architect.git"
  },
  "homepage": "https://github.com/repoassay/repo-test-architect#readme",
  "bugs": {
    "url": "https://github.com/repoassay/repo-test-architect/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "repo-test-architect": "src/cli/package-entry.js",
    "repo-test-architect-mcp": "src/mcp/stdio.js",
    "repo-test-architect-mcp-invoke": "src/mcp/invoke.js"
  },
  "files": [
    "SECURITY.md",
    "SUPPORT.md",
    "server.json",
    "docs/",
    "evals/",
    "examples/",
    "schemas/",
    "scripts/",
    "src/"
  ],
  "scripts": {
    "analyze": "node ./src/cli/index.js analyze",
    "analyze:json": "node ./src/cli/index.js analyze --format json",
    "analyze:example": "node ./src/cli/index.js analyze ./examples/polyglot-workspace",
    "analyze:example:json": "node ./src/cli/index.js analyze ./examples/polyglot-workspace --format json",
    "doctor": "node ./src/cli/index.js doctor",
    "doctor:json": "node ./src/cli/index.js doctor --format json",
    "diagnostic-bundle": "node ./src/cli/index.js diagnostic-bundle",
    "adapters": "node ./src/cli/index.js adapters",
    "adapters:json": "node ./src/cli/index.js adapters --format json",
    "detect-rules": "node ./src/cli/index.js detect-rules",
    "detect-rules:json": "node ./src/cli/index.js detect-rules --format json",
    "detect:example": "node ./src/cli/index.js detect ./examples/polyglot-workspace",
    "detect:example:json": "node ./src/cli/index.js detect ./examples/polyglot-workspace --format json",
    "detect:kotlin-fixture": "node ./src/cli/index.js detect ./examples/kotlin-junit-basic",
    "detect:kotlin-fixture:json": "node ./src/cli/index.js detect ./examples/kotlin-junit-basic --format json",
    "detect:apple-fixture": "node ./src/cli/index.js detect ./examples/apple-xcode-mixed",
    "detect:apple-fixture:json": "node ./src/cli/index.js detect ./examples/apple-xcode-mixed --format json",
    "audit-projects:example": "node ./src/cli/index.js audit-projects ./examples/polyglot-workspace",
    "audit-projects:example:json": "node ./src/cli/index.js audit-projects ./examples/polyglot-workspace --format json",
    "audit-projects:changed-since": "node ./src/cli/index.js audit-projects . --changed-since HEAD --format json",
    "summarize-projects:example": "node ./src/cli/index.js summarize-projects ./examples/polyglot-workspace",
    "summarize-projects:example:json": "node ./src/cli/index.js summarize-projects ./examples/polyglot-workspace --format json",
    "rank-projects:example": "node ./src/cli/index.js rank-projects ./examples/polyglot-workspace",
    "rank-projects:example:json": "node ./src/cli/index.js rank-projects ./examples/polyglot-workspace --format json",
    "plan-projects:example": "node ./src/cli/index.js plan-projects ./examples/polyglot-workspace",
    "plan-projects:example:json": "node ./src/cli/index.js plan-projects ./examples/polyglot-workspace --format json",
    "hints-projects:example": "node ./src/cli/index.js hints-projects ./examples/polyglot-workspace",
    "hints-projects:example:json": "node ./src/cli/index.js hints-projects ./examples/polyglot-workspace --format json",
    "findings-projects:example": "node ./src/cli/index.js findings-projects ./examples/polyglot-workspace",
    "findings-projects:example:json": "node ./src/cli/index.js findings-projects ./examples/polyglot-workspace --format json",
    "placement-projects:example": "node ./src/cli/index.js placement-projects ./examples/node-vitest-basic",
    "placement-projects:example:json": "node ./src/cli/index.js placement-projects ./examples/node-vitest-basic --format json",
    "placement-projects:split-example:json": "node ./src/cli/index.js placement-projects --from-project-audits ./examples/split-placement-project-audits.json --format json",
    "stats-projects:example": "node ./src/cli/index.js stats-projects ./examples/polyglot-workspace",
    "stats-projects:example:json": "node ./src/cli/index.js stats-projects ./examples/polyglot-workspace --format json",
    "audit:example": "node ./src/cli/index.js audit ./examples/node-vitest-basic",
    "audit:example:json": "node ./src/cli/index.js audit ./examples/node-vitest-basic --format json",
    "audit:kotlin-fixture": "node ./src/cli/index.js audit ./examples/kotlin-junit-basic --adapter kotlin",
    "audit:kotlin-fixture:json": "node ./src/cli/index.js audit ./examples/kotlin-junit-basic --adapter kotlin --format json",
    "plan:example": "node ./src/cli/index.js plan ./examples/node-vitest-basic",
    "plan:example:json": "node ./src/cli/index.js plan ./examples/node-vitest-basic --format json",
    "hints:example": "node ./src/cli/index.js hints ./examples/node-vitest-basic",
    "hints:example:json": "node ./src/cli/index.js hints ./examples/node-vitest-basic --format json",
    "plan:kotlin-fixture": "node ./src/cli/index.js plan ./examples/kotlin-junit-basic --adapter kotlin",
    "plan:kotlin-fixture:json": "node ./src/cli/index.js plan ./examples/kotlin-junit-basic --adapter kotlin --format json",
    "plan:item:example": "node ./src/cli/index.js plan ./examples/node-vitest-basic --item add-test:src/authService.ts",
    "plan:changed": "node ./src/cli/index.js plan . --changed",
    "plan:changed-since": "node ./src/cli/index.js plan . --changed-since HEAD",
    "plan:from-audit:example": "node ./src/cli/index.js plan --from-audit ./evals/expected/node-vitest-basic.audit.json",
    "explain:example": "node ./src/cli/index.js explain ./examples/node-vitest-basic --target src/authService.ts",
    "rank:example": "node ./src/cli/index.js rank ./examples/node-vitest-basic",
    "placement:example": "node ./src/cli/index.js placement ./examples/node-vitest-basic --owner node-vitest-basic",
    "placement:example:json": "node ./src/cli/index.js placement ./examples/node-vitest-basic --owner node-vitest-basic --format json",
    "placement:from-audit:example": "node ./src/cli/index.js placement --from-audit ./evals/expected/node-vitest-basic.audit.json",
    "mcp:tools": "node ./src/mcp/invoke.js tools",
    "mcp:analyze:example": "node ./src/mcp/invoke.js call analyze_repository \"{\\\"repoRoot\\\":\\\"./examples/polyglot-workspace\\\"}\"",
    "mcp:adapters": "node ./src/mcp/invoke.js call list_adapters \"{}\"",
    "mcp:detect-rules": "node ./src/mcp/invoke.js call list_project_detection_rules \"{}\"",
    "mcp:detect:example": "node ./src/mcp/invoke.js call detect_projects \"{\\\"repoRoot\\\":\\\"./examples/polyglot-workspace\\\"}\"",
    "mcp:audit-projects:example": "node ./src/mcp/invoke.js call audit_projects \"{\\\"repoRoot\\\":\\\"./examples/polyglot-workspace\\\"}\"",
    "mcp:summarize-projects:example": "node ./src/mcp/invoke.js call summarize_project_audits @./examples/mcp/polyglot-project-audits.args.json",
    "mcp:rank-projects:example": "node ./src/mcp/invoke.js call rank_project_candidates @./examples/mcp/polyglot-project-audits.args.json",
    "mcp:plan-projects:example": "node ./src/mcp/invoke.js call generate_project_test_plan @./examples/mcp/polyglot-project-audits.args.json",
    "mcp:findings-projects:example": "node ./src/mcp/invoke.js call collect_project_findings @./examples/mcp/polyglot-project-audits.args.json",
    "mcp:placement-projects:example": "node ./src/mcp/invoke.js call analyze_project_test_placement @./examples/mcp/polyglot-project-audits.args.json",
    "mcp:placement-split:example": "node ./src/mcp/invoke.js call analyze_project_test_placement @./examples/mcp/split-placement-project-audits.args.json",
    "mcp:stats-projects:example": "node ./src/mcp/invoke.js call collect_project_stats @./examples/mcp/polyglot-project-audits.args.json",
    "mcp:audit:example": "node ./src/mcp/invoke.js call audit_repo \"{\\\"repoRoot\\\":\\\"./examples/node-vitest-basic\\\"}\"",
    "mcp:audit:kotlin-fixture": "node ./src/mcp/invoke.js call audit_repo @./examples/mcp/kotlin-audit.args.json",
    "mcp:placement:example": "node ./src/mcp/invoke.js call analyze_test_placement \"{\\\"audit\\\":{\\\"schemaVersion\\\":\\\"audit/v1\\\",\\\"profile\\\":{},\\\"untestedCandidates\\\":[],\\\"coveredButRisky\\\":[],\\\"skipped\\\":[],\\\"risks\\\":[]}}\"",
    "mcp:audit:envelope": "node ./src/mcp/invoke.js call-envelope audit_repo \"{\\\"repoRoot\\\":\\\"./examples/node-vitest-basic\\\"}\"",
    "mcp:stdio": "node ./src/mcp/stdio.js",
    "mcp:smoke": "node ./scripts/check-mcp-stdio-smoke.js",
    "eval:check": "node ./scripts/check-golden-snapshots.js",
    "eval:summary": "node ./scripts/check-golden-snapshots.js",
    "eval:test": "node --test test/golden-snapshots.test.js",
    "eval:update": "node ./scripts/update-golden-snapshots.js",
    "model-consistency:check": "node ./scripts/check-model-consistency-scenarios.js",
    "model-consistency:json": "node ./scripts/check-model-consistency-scenarios.js --json",
    "model-consistency:compare": "node ./scripts/compare-model-consistency-summaries.js",
    "model-consistency:compare:profiles": "node ./scripts/compare-model-consistency-summaries.js --baseline-profile deterministic-baseline --candidate-profile local-small",
    "model-consistency:stats": "node ./scripts/collect-model-consistency-stats.js",
    "validation:repos": "node ./scripts/find-validation-repos.js",
    "corpus:check": "node ./scripts/check-validation-corpus.js",
    "corpus:scorecard": "node ./scripts/render-validation-scorecard.js",
    "corpus:measure": "node ./scripts/measure-validation-corpus.js",
    "adapter:coverage:check": "node ./scripts/check-adapter-coverage.js",
    "go:performance:check": "node ./scripts/check-go-performance.js",
    "javascript:performance:check": "node ./scripts/check-javascript-performance.js",
    "python:performance:check": "node ./scripts/check-python-performance.js",
    "kotlin:performance:check": "node ./scripts/check-kotlin-performance.js",
    "swift:performance:check": "node ./scripts/check-swift-performance.js",
    "demo:check": "node ./scripts/check-demo-script.js",
    "test": "node ./scripts/run-tests.js",
    "smoke": "node ./scripts/check-smoke.js",
    "audit:prod": "npm audit --omit=dev",
    "pack:dry-run": "npm pack --dry-run",
    "pack:check": "node ./scripts/check-pack-contents.js",
    "bin:check": "node ./scripts/check-bin-entrypoints.js",
    "installed-package:check": "node ./scripts/check-installed-package.js",
    "distribution:check": "node ./scripts/check-distribution-readiness.js",
    "distribution:check:publish": "node ./scripts/check-distribution-readiness.js --publish",
    "alpha:check": "node ./scripts/check-alpha-readiness.js",
    "release:check": "node ./scripts/check-release-readiness.js"
  },
  "keywords": [
    "testing",
    "audit",
    "agent",
    "mcp",
    "strategy"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  }
}
