{
  "name": "repo-test-architect",
  "version": "0.1.0",
  "private": true,
  "description": "Audit-first test strategy agent for repository-native test planning.",
  "type": "module",
  "bin": {
    "repo-test-architect": "./src/cli/index.js",
    "repo-test-architect-mcp": "./src/mcp/stdio.js",
    "repo-test-architect-mcp-invoke": "./src/mcp/invoke.js"
  },
  "scripts": {
    "adapters": "node ./src/cli/index.js adapters",
    "adapters:json": "node ./src/cli/index.js adapters --format json",
    "detect:example": "node ./src/cli/index.js detect ./examples/polyglot-workspace",
    "detect:example:json": "node ./src/cli/index.js detect ./examples/polyglot-workspace --format json",
    "audit-projects:example": "node ./src/cli/index.js audit-projects ./examples/polyglot-workspace",
    "audit-projects:example:json": "node ./src/cli/index.js audit-projects ./examples/polyglot-workspace --format json",
    "summarize-projects:example": "node ./src/cli/index.js summarize-projects ./examples/polyglot-workspace",
    "summarize-projects:example:json": "node ./src/cli/index.js summarize-projects ./examples/polyglot-workspace --format json",
    "rank-projects:example": "node ./src/cli/index.js rank-projects ./examples/polyglot-workspace",
    "rank-projects:example:json": "node ./src/cli/index.js rank-projects ./examples/polyglot-workspace --format json",
    "plan-projects:example": "node ./src/cli/index.js plan-projects ./examples/polyglot-workspace",
    "plan-projects:example:json": "node ./src/cli/index.js plan-projects ./examples/polyglot-workspace --format json",
    "audit:example": "node ./src/cli/index.js audit ./examples/node-vitest-basic",
    "audit:example:json": "node ./src/cli/index.js audit ./examples/node-vitest-basic --format json",
    "plan:example": "node ./src/cli/index.js plan ./examples/node-vitest-basic",
    "plan:example:json": "node ./src/cli/index.js plan ./examples/node-vitest-basic --format json",
    "plan:item:example": "node ./src/cli/index.js plan ./examples/node-vitest-basic --item add-test:src/authService.ts",
    "plan:changed": "node ./src/cli/index.js plan . --changed",
    "plan:changed-since": "node ./src/cli/index.js plan . --changed-since HEAD",
    "plan:from-audit:example": "node ./src/cli/index.js plan --from-audit ./evals/expected/node-vitest-basic.audit.json",
    "explain:example": "node ./src/cli/index.js explain ./examples/node-vitest-basic --target src/authService.ts",
    "rank:example": "node ./src/cli/index.js rank ./examples/node-vitest-basic",
    "mcp:tools": "node ./src/mcp/invoke.js tools",
    "mcp:adapters": "node ./src/mcp/invoke.js call list_adapters \"{}\"",
    "mcp:detect:example": "node ./src/mcp/invoke.js call detect_projects \"{\\\"repoRoot\\\":\\\"./examples/polyglot-workspace\\\"}\"",
    "mcp:audit-projects:example": "node ./src/mcp/invoke.js call audit_projects \"{\\\"repoRoot\\\":\\\"./examples/polyglot-workspace\\\"}\"",
    "mcp:summarize-projects:example": "node ./src/mcp/invoke.js call summarize_project_audits \"{\\\"projectAudits\\\":{\\\"schemaVersion\\\":\\\"project-audits/v1\\\",\\\"root\\\":\\\".\\\",\\\"summary\\\":{\\\"projectCount\\\":0,\\\"auditedProjectCount\\\":0,\\\"skippedProjectCount\\\":0},\\\"audits\\\":[],\\\"skippedProjects\\\":[]}}\"",
    "mcp:rank-projects:example": "node ./src/mcp/invoke.js call rank_project_candidates \"{\\\"projectAudits\\\":{\\\"schemaVersion\\\":\\\"project-audits/v1\\\",\\\"root\\\":\\\".\\\",\\\"summary\\\":{\\\"projectCount\\\":0,\\\"auditedProjectCount\\\":0,\\\"skippedProjectCount\\\":0},\\\"audits\\\":[],\\\"skippedProjects\\\":[]}}\"",
    "mcp:plan-projects:example": "node ./src/mcp/invoke.js call generate_project_test_plan \"{\\\"projectAudits\\\":{\\\"schemaVersion\\\":\\\"project-audits/v1\\\",\\\"root\\\":\\\".\\\",\\\"summary\\\":{\\\"projectCount\\\":0,\\\"auditedProjectCount\\\":0,\\\"skippedProjectCount\\\":0},\\\"audits\\\":[],\\\"skippedProjects\\\":[]}}\"",
    "mcp:audit:example": "node ./src/mcp/invoke.js call audit_repo \"{\\\"repoRoot\\\":\\\"./examples/node-vitest-basic\\\"}\"",
    "mcp:audit:envelope": "node ./src/mcp/invoke.js call-envelope audit_repo \"{\\\"repoRoot\\\":\\\"./examples/node-vitest-basic\\\"}\"",
    "mcp:stdio": "node ./src/mcp/stdio.js",
    "eval:check": "node ./scripts/check-golden-snapshots.js",
    "eval:summary": "node ./scripts/check-golden-snapshots.js",
    "eval:test": "node --test test/golden-snapshots.test.js",
    "eval:update": "node ./scripts/update-golden-snapshots.js",
    "test": "node --test \"test/**/*.test.js\"",
    "smoke": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke.ps1"
  },
  "keywords": [
    "testing",
    "audit",
    "agent",
    "strategy"
  ],
  "license": "MIT"
}
