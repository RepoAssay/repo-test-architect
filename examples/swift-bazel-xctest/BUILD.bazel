load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "CheckoutCore",
    module_name = "CheckoutCore",
    srcs = glob(["Core/*.swift"]),
)

swift_library(
    name = "CheckoutCoreTestCases",
    srcs = glob(["verification/*.swift"]),
    deps = [":CheckoutCore"],
)

swift_test(
    name = "CheckoutCoreVerification",
    deps = [":CheckoutCoreTestCases"],
)
