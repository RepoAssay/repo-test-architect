{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-stats-v1.schema.json",
  "title": "Project Stats Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root", "summary", "sourceFiles", "counts", "distributions", "adapters"],
  "properties": {
    "schemaVersion": {
      "const": "project-stats/v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectCount", "auditedProjectCount", "unsupportedProjectCount", "auditCoverage"],
      "properties": {
        "projectCount": { "type": "integer", "minimum": 0 },
        "auditedProjectCount": { "type": "integer", "minimum": 0 },
        "unsupportedProjectCount": { "type": "integer", "minimum": 0 },
        "failedProjectCount": {
          "description": "Projects whose adapter failed during audit. Present only when at least one project failed (since 1.1.0).",
          "type": "integer",
          "minimum": 1
        },
        "auditCoverage": { "enum": ["complete", "partial", "none"] }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "untestedCandidateCount",
        "coveredButRiskyCount",
        "skippedTargetCount",
        "riskCount",
        "blockerCount"
      ],
      "properties": {
        "untestedCandidateCount": { "type": "integer", "minimum": 0 },
        "coveredButRiskyCount": { "type": "integer", "minimum": 0 },
        "skippedTargetCount": { "type": "integer", "minimum": 0 },
        "riskCount": { "type": "integer", "minimum": 0 },
        "blockerCount": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "audited", "unsupported", "byLanguage"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "audited": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "byLanguage": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total", "audited", "unsupported"],
            "properties": {
              "total": { "type": "integer", "minimum": 0 },
              "audited": { "type": "integer", "minimum": 0 },
              "unsupported": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "distributions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "testFrameworks", "testCommands", "targetKinds", "riskLevels", "signals", "evidenceStrengths", "evidenceKinds", "evidenceUsage", "evidenceViaUsage"],
      "properties": {
        "confidence": { "$ref": "#/$defs/countRecord" },
        "testFrameworks": { "$ref": "#/$defs/countRecord" },
        "testCommands": { "$ref": "#/$defs/countRecord" },
        "targetKinds": { "$ref": "#/$defs/countRecord" },
        "riskLevels": { "$ref": "#/$defs/countRecord" },
        "signals": { "$ref": "#/$defs/countRecord" },
        "evidenceStrengths": { "$ref": "#/$defs/countRecord" },
        "evidenceKinds": { "$ref": "#/$defs/countRecord" },
        "evidenceUsage": { "$ref": "#/$defs/countRecord" },
        "evidenceViaUsage": { "$ref": "#/$defs/countRecord" }
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapterId", "projectCount"],
        "properties": {
          "adapterId": { "type": "string", "minLength": 1 },
          "projectCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "failedProjects": {
      "description": "Supported projects whose adapter failed during audit, copied from project-audits/v1. Present only when at least one project failed (since 1.1.0).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "projectRoot", "adapterId", "ecosystems", "languages", "errorName", "reason"],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "adapterId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "ecosystems": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "languages": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "errorName": { "enum": ["AggregateError", "Error", "EvalError", "RangeError", "ReferenceError", "SyntaxError", "TypeError", "URIError"] },
          "errorCode": { "enum": ["EACCES", "EIO", "EISDIR", "ELOOP", "EMFILE", "ENAMETOOLONG", "ENFILE", "ENOENT", "ENOMEM", "ENOTDIR", "EPERM"] },
          "reason": { "type": "string", "maxLength": 240, "pattern": "^The [a-z][a-z0-9-]{0,63} adapter failed with (?:AggregateError|Error|EvalError|RangeError|ReferenceError|SyntaxError|TypeError|URIError)\\.(?: (?:Permission was denied while reading the project\\.|An input or output error occurred while reading the project\\.|A directory was found where a file was expected\\.|Too many symbolic links were encountered while reading the project\\.|The process ran out of file handles while reading the project\\.|A file name in the project is too long\\.|The system ran out of file handles while reading the project\\.|A file or directory disappeared or was not found during the audit\\.|The system ran out of memory while reading the project\\.|A file was found where a directory was expected\\.|The operation was not permitted while reading the project\\.))?$" }
        }
      }
    }
  },
  "$defs": {
    "countRecord": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
