{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-audits-v1.schema.json",
  "title": "Project Audits Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root", "summary", "audits", "skippedProjects"],
  "properties": {
    "schemaVersion": {
      "const": "project-audits/v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectCount", "auditedProjectCount", "skippedProjectCount"],
      "properties": {
        "projectCount": {
          "type": "integer",
          "minimum": 0
        },
        "auditedProjectCount": {
          "type": "integer",
          "minimum": 0
        },
        "skippedProjectCount": {
          "type": "integer",
          "minimum": 0
        },
        "failedProjectCount": {
          "description": "Projects whose adapter failed during audit. Emitted since 1.1.0; absent from earlier artifacts.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "projectRoot", "adapterId", "audit"],
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "projectRoot": {
            "type": "string",
            "minLength": 1
          },
          "adapterId": {
            "type": "string",
            "minLength": 1
          },
          "audit": {
            "type": "object",
            "additionalProperties": true,
            "required": ["schemaVersion", "profile", "untestedCandidates", "coveredButRisky", "skipped", "risks"],
            "properties": {
              "schemaVersion": {
                "const": "audit/v1"
              },
              "profile": {
                "type": "object"
              },
              "untestedCandidates": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "coveredButRisky": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "skipped": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "skippedProjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "projectRoot",
          "reason",
          "ecosystems",
          "languages",
          "adapterMatches",
          "supportStatusReason"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "projectRoot": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "ecosystems": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "adapterMatches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["adapterId", "maturity", "matchedEcosystems", "matchedLanguages"],
              "properties": {
                "adapterId": {
                  "type": "string",
                  "minLength": 1
                },
                "maturity": {
                  "enum": ["supported", "experimental", "planned"]
                },
                "matchedEcosystems": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "matchedLanguages": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "supportStatusReason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failedProjects": {
      "description": "Supported projects whose adapter threw during audit, with a fixed public error summary. Emitted since 1.1.0 (possibly empty); absent from earlier artifacts.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/failedProject"
      }
    }
  },
  "$defs": {
    "failedProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "projectRoot", "adapterId", "ecosystems", "languages", "errorName", "reason"],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "projectRoot": {
          "type": "string",
          "minLength": 1
        },
        "adapterId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "ecosystems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "errorName": {
          "description": "The thrown error's built-in class name; any other name is recorded as Error.",
          "enum": ["AggregateError", "Error", "EvalError", "RangeError", "ReferenceError", "SyntaxError", "TypeError", "URIError"]
        },
        "errorCode": {
          "description": "An allowlisted Node.js file-system error code, when the thrown error carried one.",
          "enum": ["EACCES", "EIO", "EISDIR", "ELOOP", "EMFILE", "ENAMETOOLONG", "ENFILE", "ENOENT", "ENOMEM", "ENOTDIR", "EPERM"]
        },
        "reason": {
          "description": "Fixed public summary built from adapterId, errorName and errorCode. Error messages are intentionally not recorded.",
          "type": "string",
          "maxLength": 240,
          "pattern": "^The [a-z][a-z0-9-]{0,63} adapter failed with (?:AggregateError|Error|EvalError|RangeError|ReferenceError|SyntaxError|TypeError|URIError)\\.(?: (?:Permission was denied while reading the project\\.|An input or output error occurred while reading the project\\.|A directory was found where a file was expected\\.|Too many symbolic links were encountered while reading the project\\.|The process ran out of file handles while reading the project\\.|A file name in the project is too long\\.|The system ran out of file handles while reading the project\\.|A file or directory disappeared or was not found during the audit\\.|The system ran out of memory while reading the project\\.|A file was found where a directory was expected\\.|The operation was not permitted while reading the project\\.))?$"
        }
      }
    }
  }
}
