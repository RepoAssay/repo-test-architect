{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-audits-v1.schema.json",
  "title": "Project Audits Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root", "summary", "audits", "skippedProjects"],
  "properties": {
    "schemaVersion": {
      "const": "project-audits/v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectCount", "auditedProjectCount", "skippedProjectCount"],
      "properties": {
        "projectCount": {
          "type": "integer",
          "minimum": 0
        },
        "auditedProjectCount": {
          "type": "integer",
          "minimum": 0
        },
        "skippedProjectCount": {
          "type": "integer",
          "minimum": 0
        },
        "failedProjectCount": {
          "description": "Projects whose adapter failed during audit. Emitted since 1.1.0; absent from earlier artifacts.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "projectRoot", "adapterId", "audit"],
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "projectRoot": {
            "type": "string",
            "minLength": 1
          },
          "adapterId": {
            "type": "string",
            "minLength": 1
          },
          "audit": {
            "type": "object",
            "additionalProperties": true,
            "required": ["schemaVersion", "profile", "untestedCandidates", "coveredButRisky", "skipped", "risks"],
            "properties": {
              "schemaVersion": {
                "const": "audit/v1"
              },
              "profile": {
                "type": "object"
              },
              "untestedCandidates": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "coveredButRisky": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "skipped": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "skippedProjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "projectRoot",
          "reason",
          "ecosystems",
          "languages",
          "adapterMatches",
          "supportStatusReason"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "projectRoot": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "ecosystems": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "adapterMatches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["adapterId", "maturity", "matchedEcosystems", "matchedLanguages"],
              "properties": {
                "adapterId": {
                  "type": "string",
                  "minLength": 1
                },
                "maturity": {
                  "enum": ["supported", "experimental", "planned"]
                },
                "matchedEcosystems": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "matchedLanguages": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "supportStatusReason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failedProjects": {
      "description": "Supported projects whose adapter threw during audit, with a sanitized error summary. Emitted since 1.1.0 (possibly empty); absent from earlier artifacts.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/failedProject"
      }
    }
  },
  "$defs": {
    "failedProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "projectRoot", "adapterId", "ecosystems", "languages", "errorName", "reason"],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "projectRoot": {
          "type": "string",
          "minLength": 1
        },
        "adapterId": {
          "type": "string",
          "minLength": 1
        },
        "ecosystems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "errorName": {
          "description": "The thrown error's name, such as Error or TypeError.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_$]{0,63}$"
        },
        "errorCode": {
          "description": "A Node.js-style error code such as ENOENT, when the error carried one.",
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "reason": {
          "description": "First line of the error message without absolute paths, quoted content or stack frames, at most 200 characters.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
