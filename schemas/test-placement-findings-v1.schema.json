{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-placement-findings-v1.schema.json",
  "title": "Test Placement Findings Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "findings"],
  "properties": {
    "schemaVersion": {
      "const": "test-placement-findings/v1"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "testFile",
          "currentOwner",
          "suggestedOwner",
          "action",
          "reason",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "testFile": {
            "type": "string",
            "minLength": 1
          },
          "currentOwner": {
            "type": "string",
            "minLength": 1
          },
          "suggestedOwner": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": ["move", "split", "keep"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
