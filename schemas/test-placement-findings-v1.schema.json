{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-placement-findings-v1.schema.json",
  "title": "Test Placement Findings Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "findings"],
  "properties": {
    "schemaVersion": {
      "const": "test-placement-findings/v1"
    },
    "auditCoverage": {
      "description": "Project placement only: audit coverage of the source project-audits/v1 artifact. Present only when at least one project failed (since 1.1.0).",
      "enum": ["partial", "none"]
    },
    "failedProjectCount": {
      "description": "Project placement only: projects whose adapter failed during audit. Present only when at least one project failed (since 1.1.0).",
      "type": "integer",
      "minimum": 1
    },
    "failedProjects": {
      "description": "Supported projects whose adapter failed during audit, copied from the source artifact. Present only when at least one project failed (since 1.1.0).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "projectRoot", "adapterId", "ecosystems", "languages", "errorName", "reason"],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "adapterId": { "type": "string", "minLength": 1 },
          "ecosystems": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "languages": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "errorName": { "enum": ["AggregateError", "Error", "EvalError", "RangeError", "ReferenceError", "SyntaxError", "TypeError", "URIError"] },
          "errorCode": { "enum": ["EACCES", "EIO", "EISDIR", "ELOOP", "EMFILE", "ENAMETOOLONG", "ENFILE", "ENOENT", "ENOMEM", "ENOTDIR", "EPERM"] },
          "reason": { "type": "string", "maxLength": 240, "pattern": "^The [a-z][a-z0-9-]{0,63} adapter failed with (?:AggregateError|Error|EvalError|RangeError|ReferenceError|SyntaxError|TypeError|URIError)\\.(?: [A-Z][A-Za-z ]{0,120}\\.)?$" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "testFile",
          "currentOwner",
          "suggestedOwner",
          "action",
          "reason",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "testFile": {
            "type": "string",
            "minLength": 1
          },
          "currentOwner": {
            "type": "string",
            "minLength": 1
          },
          "suggestedOwner": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": ["move", "split", "keep"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
