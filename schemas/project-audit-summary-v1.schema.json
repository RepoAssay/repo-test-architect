{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-audit-summary-v1.schema.json",
  "title": "Project Audit Summary Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root", "summary", "projects", "unsupportedProjects"],
  "properties": {
    "schemaVersion": {
      "const": "project-audit-summary/v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectCount",
        "auditedProjectCount",
        "unsupportedProjectCount",
        "auditCoverage",
        "unsupportedReasons",
        "untestedCandidateCount",
        "coveredButRiskyCount",
        "skippedTargetCount",
        "riskCount"
      ],
      "properties": {
        "projectCount": { "type": "integer", "minimum": 0 },
        "auditedProjectCount": { "type": "integer", "minimum": 0 },
        "unsupportedProjectCount": { "type": "integer", "minimum": 0 },
        "failedProjectCount": {
          "description": "Projects whose adapter failed during audit. Present only when at least one project failed (since 1.1.0).",
          "type": "integer",
          "minimum": 1
        },
        "auditCoverage": { "enum": ["complete", "partial", "none"] },
        "unsupportedReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "untestedCandidateCount": { "type": "integer", "minimum": 0 },
        "coveredButRiskyCount": { "type": "integer", "minimum": 0 },
        "skippedTargetCount": { "type": "integer", "minimum": 0 },
        "riskCount": { "type": "integer", "minimum": 0 }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "projectRoot",
          "adapterId",
          "confidence",
          "untestedCandidateCount",
          "coveredButRiskyCount",
          "skippedTargetCount",
          "riskCount",
          "topCandidateIds"
        ],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "adapterId": { "type": "string", "minLength": 1 },
          "confidence": { "type": "string", "minLength": 1 },
          "testCommand": { "type": "string" },
          "untestedCandidateCount": { "type": "integer", "minimum": 0 },
          "coveredButRiskyCount": { "type": "integer", "minimum": 0 },
          "skippedTargetCount": { "type": "integer", "minimum": 0 },
          "riskCount": { "type": "integer", "minimum": 0 },
          "topCandidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "unsupportedProjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "projectRoot",
          "reason",
          "ecosystems",
          "languages",
          "adapterMatches",
          "supportStatusReason"
        ],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "ecosystems": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "languages": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "adapterMatches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["adapterId", "maturity", "matchedEcosystems", "matchedLanguages"],
              "properties": {
                "adapterId": { "type": "string", "minLength": 1 },
                "maturity": { "enum": ["supported", "experimental", "planned"] },
                "matchedEcosystems": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "matchedLanguages": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "supportStatusReason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failedProjects": {
      "description": "Supported projects whose adapter failed during audit, copied from project-audits/v1. Present only when at least one project failed (since 1.1.0).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "projectRoot", "adapterId", "ecosystems", "languages", "errorName", "reason"],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "adapterId": { "type": "string", "minLength": 1 },
          "ecosystems": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "languages": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "errorName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_$]{0,63}$" },
          "errorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
