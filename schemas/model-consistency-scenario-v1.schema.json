{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-test-architect.local/schemas/model-consistency-scenario-v1.schema.json",
  "title": "Repo Test Architect Model Consistency Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "description",
    "sourceArtifact",
    "toolCall",
    "lockedFields",
    "allowedVariations",
    "unexpectedVariations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "model-consistency-scenario/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schemaVersion"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolName",
        "arguments"
      ],
      "properties": {
        "toolName": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    "lockedFields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "expected",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "oneOf": [
              { "type": "string" },
              { "type": "integer" },
              { "type": "boolean" }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "allowedVariations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unexpectedVariations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
