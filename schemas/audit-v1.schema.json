{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-test-architect.local/schemas/audit-v1.schema.json",
  "title": "Repo Test Architect Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "untestedCandidates",
    "coveredButRisky",
    "recommended",
    "skipped",
    "risks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "audit/v1"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "languages",
        "packageManagers",
        "testFrameworks",
        "architectures",
        "detectedConventions",
        "existingTestLocations",
        "setupSignals",
        "confidence",
        "blockers"
      ],
      "properties": {
        "root": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "packageManagers": { "type": "array", "items": { "type": "string" } },
        "testFrameworks": { "type": "array", "items": { "type": "string" } },
        "architectures": { "type": "array", "items": { "type": "string" } },
        "testCommand": { "type": "string" },
        "detectedConventions": { "type": "array", "items": { "type": "string" } },
        "existingTestLocations": { "type": "array", "items": { "type": "string" } },
        "setupSignals": { "type": "array", "items": { "type": "string" } },
        "confidence": { "enum": ["low", "medium", "high"] },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "untestedCandidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/auditTarget" }
    },
    "coveredButRisky": {
      "type": "array",
      "items": { "$ref": "#/$defs/auditTarget" }
    },
    "recommended": {
      "type": "array",
      "items": { "$ref": "#/$defs/auditTarget" }
    },
    "skipped": {
      "type": "array",
      "items": { "$ref": "#/$defs/skippedTarget" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "auditTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "path",
        "kind",
        "signals",
        "risk",
        "testability",
        "recommendedTestLevel",
        "riskReductionScore",
        "maintenanceCost",
        "reasons",
        "existingTestPaths"
      ],
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "signals": { "type": "array", "items": { "type": "string" } },
        "risk": { "enum": ["low", "medium", "high"] },
        "testability": { "enum": ["low", "medium", "high"] },
        "recommendedTestLevel": { "enum": ["unit", "integration", "component", "ui", "none"] },
        "riskReductionScore": { "type": "integer", "minimum": 0, "maximum": 10 },
        "maintenanceCost": { "type": "integer", "minimum": 0, "maximum": 10 },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "existingTestPaths": { "type": "array", "items": { "type": "string" } },
        "existingTestEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["testPath", "kind", "strength"],
            "properties": {
              "testPath": { "type": "string" },
              "kind": {
                "enum": [
                  "filename-convention",
                  "direct-relative-import",
                  "referenced-relative-reexport",
                  "tsconfig-path-import",
                  "package-entry-import",
                  "bounded-dependency",
                  "browser-route-match",
                  "swift-symbol-reference",
                  "python-module-import",
                  "python-package-reexport",
                  "python-pytest-fixture",
                  "python-test-client-route",
                  "jvm-symbol-reference",
                  "go-symbol-reference",
                  "go-source-dependency"
                ]
              },
              "strength": { "enum": ["naming", "direct", "referenced", "indirect"] },
              "usage": { "enum": ["called", "asserted"] },
              "viaUsage": { "enum": ["called", "asserted"] }
            }
          }
        }
      }
    },
    "skippedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "path",
        "kind",
        "signals",
        "riskReductionScore",
        "maintenanceCost",
        "reason"
      ],
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "signals": { "type": "array", "items": { "type": "string" } },
        "riskReductionScore": { "type": "integer", "minimum": 0, "maximum": 10 },
        "maintenanceCost": { "type": "integer", "minimum": 0, "maximum": 10 },
        "reason": { "type": "string" },
        "preferredCoveragePath": { "type": "string" }
      }
    }
  }
}
