{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-test-plan-v1.schema.json",
  "title": "Project Test Plan Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root", "summary", "unsupportedProjects", "projectPlans", "items"],
  "properties": {
    "schemaVersion": { "const": "project-test-plan/v1" },
    "root": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectCount",
        "plannedProjectCount",
        "unsupportedProjectCount",
        "auditCoverage",
        "unsupportedReasons",
        "addTestCount",
        "extendTestCount",
        "deferredCount",
        "itemCount"
      ],
      "properties": {
        "projectCount": { "type": "integer", "minimum": 0 },
        "plannedProjectCount": { "type": "integer", "minimum": 0 },
        "unsupportedProjectCount": { "type": "integer", "minimum": 0 },
        "failedProjectCount": {
          "description": "Projects whose adapter failed during audit. Present only when at least one project failed (since 1.1.0).",
          "type": "integer",
          "minimum": 1
        },
        "auditCoverage": { "enum": ["complete", "partial", "none"] },
        "unsupportedReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "addTestCount": { "type": "integer", "minimum": 0 },
        "extendTestCount": { "type": "integer", "minimum": 0 },
        "deferredCount": { "type": "integer", "minimum": 0 },
        "itemCount": { "type": "integer", "minimum": 0 }
      }
    },
    "unsupportedProjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "projectRoot",
          "reason",
          "ecosystems",
          "languages",
          "adapterMatches",
          "supportStatusReason"
        ],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "ecosystems": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "languages": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "adapterMatches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["adapterId", "maturity", "matchedEcosystems", "matchedLanguages"],
              "properties": {
                "adapterId": { "type": "string", "minLength": 1 },
                "maturity": { "enum": ["supported", "experimental", "planned"] },
                "matchedEcosystems": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "matchedLanguages": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "supportStatusReason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failedProjects": {
      "description": "Supported projects whose adapter failed during audit, copied from project-audits/v1. Present only when at least one project failed (since 1.1.0).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "projectRoot", "adapterId", "ecosystems", "languages", "errorName", "reason"],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "adapterId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "ecosystems": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "languages": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "errorName": { "enum": ["AggregateError", "Error", "EvalError", "RangeError", "ReferenceError", "SyntaxError", "TypeError", "URIError"] },
          "errorCode": { "enum": ["EACCES", "EIO", "EISDIR", "ELOOP", "EMFILE", "ENAMETOOLONG", "ENFILE", "ENOENT", "ENOMEM", "ENOTDIR", "EPERM"] },
          "reason": { "type": "string", "maxLength": 240, "pattern": "^The [a-z][a-z0-9-]{0,63} adapter failed with (?:AggregateError|Error|EvalError|RangeError|ReferenceError|SyntaxError|TypeError|URIError)\\.(?: (?:Permission was denied while reading the project\\.|An input or output error occurred while reading the project\\.|A directory was found where a file was expected\\.|Too many symbolic links were encountered while reading the project\\.|The process ran out of file handles while reading the project\\.|A file name in the project is too long\\.|The system ran out of file handles while reading the project\\.|A file or directory disappeared or was not found during the audit\\.|The system ran out of memory while reading the project\\.|A file was found where a directory was expected\\.|The operation was not permitted while reading the project\\.))?$" }
        }
      }
    },
    "projectPlans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "projectRoot", "adapterId", "plan"],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "adapterId": { "type": "string", "minLength": 1 },
          "plan": {
            "type": "object",
            "additionalProperties": true,
            "required": ["schemaVersion", "summary", "blockers", "items"],
            "properties": {
              "schemaVersion": { "const": "plan/v1" },
              "summary": { "type": "object" },
              "blockers": { "type": "array" },
              "items": { "type": "array" }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "projectRoot",
          "adapterId",
          "projectItemId",
          "id",
          "action",
          "targetId",
          "target",
          "path",
          "testLevel",
          "priority",
          "riskReductionScore",
          "maintenanceCost",
          "rationale",
          "sourceSignals",
          "existingTestPaths"
        ],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "adapterId": { "type": "string", "minLength": 1 },
          "projectItemId": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "action": { "enum": ["add-test", "extend-test", "defer"] },
          "targetId": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "testLevel": { "enum": ["unit", "integration", "component", "ui", "none"] },
          "priority": { "type": "integer" },
          "riskReductionScore": { "type": "integer", "minimum": 0, "maximum": 10 },
          "maintenanceCost": { "type": "integer", "minimum": 0, "maximum": 10 },
          "rationale": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sourceSignals": {
            "type": "array",
            "items": { "type": "string" }
          },
          "existingTestPaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "existingTestEvidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["testPath", "kind", "strength"],
              "properties": {
                "testPath": { "type": "string" },
                "kind": { "type": "string" },
                "strength": { "enum": ["naming", "direct", "referenced", "indirect"] },
                "usage": { "enum": ["called", "asserted"] },
                "viaUsage": { "enum": ["called", "asserted"] }
              }
            }
          }
        }
      }
    }
  }
}
