{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-test-architect.local/schemas/plan-execution-hints-v1.schema.json",
  "title": "Repo Test Architect Plan Execution Hints",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "summary", "items"],
  "properties": {
    "schemaVersion": { "const": "plan-execution-hints/v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "itemCount"],
      "properties": {
        "schemaVersion": { "enum": ["plan/v1", "project-test-plan/v1"] },
        "itemCount": { "type": "integer", "minimum": 0 },
        "root": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemCount",
        "lowComplexityCount",
        "mediumComplexityCount",
        "highComplexityCount",
        "parallelizableCount",
        "repositoryReasoningCount"
      ],
      "properties": {
        "itemCount": { "type": "integer", "minimum": 0 },
        "lowComplexityCount": { "type": "integer", "minimum": 0 },
        "mediumComplexityCount": { "type": "integer", "minimum": 0 },
        "highComplexityCount": { "type": "integer", "minimum": 0 },
        "parallelizableCount": { "type": "integer", "minimum": 0 },
        "repositoryReasoningCount": { "type": "integer", "minimum": 0 },
        "auditCoverage": {
          "description": "Copied from a project-test-plan/v1 source whose audit had failed projects (since 1.1.0).",
          "enum": ["partial", "none"]
        },
        "failedProjectCount": {
          "description": "Projects whose adapter failed during the source audit. Present only when at least one project failed (since 1.1.0).",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "failedProjects": {
      "description": "Supported projects whose adapter failed during audit, copied from the source artifact. Present only when at least one project failed (since 1.1.0).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "projectRoot", "adapterId", "ecosystems", "languages", "errorName", "reason"],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "adapterId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "ecosystems": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "languages": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "errorName": { "enum": ["AggregateError", "Error", "EvalError", "RangeError", "ReferenceError", "SyntaxError", "TypeError", "URIError"] },
          "errorCode": { "enum": ["EACCES", "EIO", "EISDIR", "ELOOP", "EMFILE", "ENAMETOOLONG", "ENFILE", "ENOENT", "ENOMEM", "ENOTDIR", "EPERM"] },
          "reason": { "type": "string", "maxLength": 240, "pattern": "^The [a-z][a-z0-9-]{0,63} adapter failed with (?:AggregateError|Error|EvalError|RangeError|ReferenceError|SyntaxError|TypeError|URIError)\\.(?: (?:Permission was denied while reading the project\\.|An input or output error occurred while reading the project\\.|A directory was found where a file was expected\\.|Too many symbolic links were encountered while reading the project\\.|The process ran out of file handles while reading the project\\.|A file name in the project is too long\\.|The system ran out of file handles while reading the project\\.|A file or directory disappeared or was not found during the audit\\.|The system ran out of memory while reading the project\\.|A file was found where a directory was expected\\.|The operation was not permitted while reading the project\\.))?$" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "planItemId",
          "action",
          "target",
          "path",
          "complexity",
          "contextScope",
          "parallelizable",
          "recommendedAgentRole",
          "requiresRepositoryReasoning",
          "reasons"
        ],
        "properties": {
          "planItemId": { "type": "string", "minLength": 1 },
          "action": { "enum": ["add-test", "extend-test", "defer"] },
          "target": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "adapterId": { "type": "string", "minLength": 1 },
          "complexity": { "enum": ["low", "medium", "high"] },
          "contextScope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "paths",
              "includeBuildConfiguration",
              "includeRepositoryInstructions"
            ],
            "properties": {
              "mode": { "enum": ["target-only", "target-and-tests", "project-boundary"] },
              "paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "includeBuildConfiguration": { "type": "boolean" },
              "includeRepositoryInstructions": { "const": true }
            }
          },
          "parallelizable": { "type": "boolean" },
          "recommendedAgentRole": { "enum": ["implementation", "repository-reasoning", "review"] },
          "requiresRepositoryReasoning": { "type": "boolean" },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
