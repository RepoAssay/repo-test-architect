{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-findings-v1.schema.json",
  "title": "Project Findings Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root", "summary", "findings", "unsupportedProjects"],
  "properties": {
    "schemaVersion": { "const": "project-findings/v1" },
    "root": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectCount",
        "auditedProjectCount",
        "unsupportedProjectCount",
        "auditCoverage",
        "unsupportedReasons",
        "findingCount",
        "displayedFindingCount",
        "maxFindings",
        "highSeverityCount",
        "placementFindingCount",
        "blockedProjectCount",
        "categoryCounts"
      ],
      "properties": {
        "projectCount": { "type": "integer", "minimum": 0 },
        "auditedProjectCount": { "type": "integer", "minimum": 0 },
        "unsupportedProjectCount": { "type": "integer", "minimum": 0 },
        "failedProjectCount": {
          "description": "Projects whose adapter failed during audit. Present only when at least one project failed (since 1.1.0).",
          "type": "integer",
          "minimum": 1
        },
        "auditCoverage": { "enum": ["complete", "partial", "none"] },
        "unsupportedReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "findingCount": { "type": "integer", "minimum": 0 },
        "displayedFindingCount": { "type": "integer", "minimum": 0 },
        "maxFindings": { "type": "integer", "minimum": 1 },
        "highSeverityCount": { "type": "integer", "minimum": 0 },
        "placementFindingCount": { "type": "integer", "minimum": 0 },
        "blockedProjectCount": { "type": "integer", "minimum": 0 },
        "categoryCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missing-coverage",
            "weak-existing-coverage",
            "misplaced-coverage",
            "low-value-direct-test",
            "blocked-project"
          ],
          "properties": {
            "missing-coverage": { "type": "integer", "minimum": 0 },
            "weak-existing-coverage": { "type": "integer", "minimum": 0 },
            "misplaced-coverage": { "type": "integer", "minimum": 0 },
            "low-value-direct-test": { "type": "integer", "minimum": 0 },
            "blocked-project": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "severity",
          "priority",
          "projectId",
          "projectRoot",
          "title",
          "rationale",
          "evidence",
          "existingTestPaths"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": {
            "enum": [
              "missing-coverage",
              "weak-existing-coverage",
              "misplaced-coverage",
              "low-value-direct-test",
              "blocked-project"
            ]
          },
          "severity": { "enum": ["high", "medium", "low"] },
          "priority": { "type": "integer" },
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "adapterId": { "type": "string", "minLength": 1 },
          "targetId": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "testLevel": { "enum": ["unit", "integration", "component", "ui", "none"] },
          "title": { "type": "string", "minLength": 1 },
          "testFile": { "type": "string", "minLength": 1 },
          "currentOwner": { "type": "string", "minLength": 1 },
          "suggestedOwner": { "type": "string", "minLength": 1 },
          "action": { "enum": ["move", "split", "keep"] },
          "rationale": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "existingTestPaths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "unsupportedProjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["projectId", "projectRoot", "reason", "ecosystems", "languages", "adapterMatches", "supportStatusReason"],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "ecosystems": { "type": "array" },
          "languages": { "type": "array" },
          "adapterMatches": { "type": "array" },
          "supportStatusReason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "failedProjects": {
      "description": "Supported projects whose adapter failed during audit, copied from project-audits/v1. Present only when at least one project failed (since 1.1.0).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "projectRoot", "adapterId", "ecosystems", "languages", "errorName", "reason"],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "adapterId": { "type": "string", "minLength": 1 },
          "ecosystems": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "languages": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "errorName": { "enum": ["AggregateError", "Error", "EvalError", "RangeError", "ReferenceError", "SyntaxError", "TypeError", "URIError"] },
          "errorCode": { "enum": ["EACCES", "EIO", "EISDIR", "ELOOP", "EMFILE", "ENAMETOOLONG", "ENFILE", "ENOENT", "ENOMEM", "ENOTDIR", "EPERM"] },
          "reason": { "type": "string", "maxLength": 240, "pattern": "^The [a-z][a-z0-9-]{0,63} adapter failed with (?:AggregateError|Error|EvalError|RangeError|ReferenceError|SyntaxError|TypeError|URIError)\\.(?: [A-Z][A-Za-z ]{0,120}\\.)?$" }
        }
      }
    }
  }
}
