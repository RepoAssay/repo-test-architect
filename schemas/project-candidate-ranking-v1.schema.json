{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-candidate-ranking-v1.schema.json",
  "title": "Project Candidate Ranking Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root", "summary", "unsupportedProjects", "candidates"],
  "properties": {
    "schemaVersion": {
      "const": "project-candidate-ranking/v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectCount",
        "auditedProjectCount",
        "unsupportedProjectCount",
        "auditCoverage",
        "unsupportedReasons",
        "candidateCount"
      ],
      "properties": {
        "projectCount": { "type": "integer", "minimum": 0 },
        "auditedProjectCount": { "type": "integer", "minimum": 0 },
        "unsupportedProjectCount": { "type": "integer", "minimum": 0 },
        "auditCoverage": { "enum": ["complete", "partial", "none"] },
        "unsupportedReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "candidateCount": { "type": "integer", "minimum": 0 }
      }
    },
    "unsupportedProjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "projectRoot",
          "reason",
          "ecosystems",
          "languages",
          "adapterMatches",
          "supportStatusReason"
        ],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "ecosystems": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "languages": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "adapterMatches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["adapterId", "maturity", "matchedEcosystems", "matchedLanguages"],
              "properties": {
                "adapterId": { "type": "string", "minLength": 1 },
                "maturity": { "enum": ["supported", "experimental", "planned"] },
                "matchedEcosystems": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "matchedLanguages": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "supportStatusReason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "projectRoot",
          "adapterId",
          "projectTargetId",
          "targetId",
          "target",
          "path",
          "category",
          "kind",
          "testLevel",
          "priority",
          "riskReductionScore",
          "maintenanceCost",
          "signals",
          "rationale",
          "existingTestPaths"
        ],
        "properties": {
          "projectId": { "type": "string", "minLength": 1 },
          "projectRoot": { "type": "string", "minLength": 1 },
          "adapterId": { "type": "string", "minLength": 1 },
          "projectTargetId": { "type": "string", "minLength": 1 },
          "targetId": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "category": { "enum": ["untested", "covered-but-risky"] },
          "kind": { "type": "string", "minLength": 1 },
          "testLevel": { "enum": ["unit", "integration", "component", "ui", "none"] },
          "priority": { "type": "integer" },
          "riskReductionScore": { "type": "integer", "minimum": 0, "maximum": 10 },
          "maintenanceCost": { "type": "integer", "minimum": 0, "maximum": 10 },
          "signals": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rationale": {
            "type": "array",
            "items": { "type": "string" }
          },
          "existingTestPaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "existingTestEvidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["testPath", "kind", "strength"],
              "properties": {
                "testPath": { "type": "string" },
                "kind": { "type": "string" },
                "strength": { "enum": ["naming", "direct", "referenced", "indirect"] },
                "usage": { "enum": ["called", "asserted"] },
                "viaUsage": { "enum": ["called", "asserted"] }
              }
            }
          }
        }
      }
    }
  }
}
