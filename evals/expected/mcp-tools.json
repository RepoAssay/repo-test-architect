{
  "tools": [
    {
      "name": "list_adapters",
      "description": "List registered language adapters available to audit repositories.",
      "outputArtifact": {
        "schemaVersion": "adapter-registry/v1",
        "schemaPath": "schemas/adapter-registry-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    },
    {
      "name": "list_project_detection_rules",
      "description": "List deterministic project marker rules and ignored directories used during project detection.",
      "outputArtifact": {
        "schemaVersion": "project-detection-rules/v1",
        "schemaPath": "schemas/project-detection-rules-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    },
    {
      "name": "detect_projects",
      "description": "Detect project roots and matching adapters inside a repository.",
      "outputArtifact": {
        "schemaVersion": "project-detection/v1",
        "schemaPath": "schemas/project-detection-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repoRoot"
        ],
        "properties": {
          "repoRoot": {
            "type": "string",
            "description": "Repository root path."
          }
        }
      }
    },
    {
      "name": "audit_projects",
      "description": "Audit detected supported projects and report unsupported project roots.",
      "outputArtifact": {
        "schemaVersion": "project-audits/v1",
        "schemaPath": "schemas/project-audits-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repoRoot"
        ],
        "properties": {
          "repoRoot": {
            "type": "string",
            "description": "Repository root path."
          }
        }
      }
    },
    {
      "name": "summarize_project_audits",
      "description": "Summarize project audit coverage, unsupported reasons, and project-level counts without merging cross-project rankings.",
      "outputArtifact": {
        "schemaVersion": "project-audit-summary/v1",
        "schemaPath": "schemas/project-audit-summary-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectAudits"
        ],
        "properties": {
          "projectAudits": {
            "type": "object",
            "description": "A project-audits/v1 artifact."
          }
        }
      }
    },
    {
      "name": "rank_project_candidates",
      "description": "Rank test candidates across project-audits while preserving project identity.",
      "outputArtifact": {
        "schemaVersion": "project-candidate-ranking/v1",
        "schemaPath": "schemas/project-candidate-ranking-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectAudits"
        ],
        "properties": {
          "projectAudits": {
            "type": "object",
            "description": "A project-audits/v1 artifact."
          }
        }
      }
    },
    {
      "name": "generate_project_test_plan",
      "description": "Generate a project-aware test plan from audited project roots.",
      "outputArtifact": {
        "schemaVersion": "project-test-plan/v1",
        "schemaPath": "schemas/project-test-plan-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectAudits"
        ],
        "properties": {
          "projectAudits": {
            "type": "object",
            "description": "A project-audits/v1 artifact."
          }
        }
      }
    },
    {
      "name": "analyze_project_test_placement",
      "description": "Analyze project-aware test placement from a project-audits artifact.",
      "outputArtifact": {
        "schemaVersion": "test-placement-findings/v1",
        "schemaPath": "schemas/test-placement-findings-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectAudits"
        ],
        "properties": {
          "projectAudits": {
            "type": "object",
            "description": "A project-audits/v1 artifact."
          }
        }
      }
    },
    {
      "name": "audit_repo",
      "description": "Audit a repository and return the deterministic audit graph.",
      "outputArtifact": {
        "schemaVersion": "audit/v1",
        "schemaPath": "schemas/audit-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repoRoot"
        ],
        "properties": {
          "repoRoot": {
            "type": "string",
            "description": "Repository root path."
          },
          "adapterId": {
            "type": "string",
            "description": "Optional adapter id. Defaults to javascript."
          },
          "changedPaths": {
            "type": "array",
            "description": "Optional repository-relative source paths to limit target selection.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "name": "get_audit_graph",
      "description": "Return a validated audit graph artifact.",
      "outputArtifact": {
        "schemaVersion": "audit/v1",
        "schemaPath": "schemas/audit-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audit"
        ],
        "properties": {
          "audit": {
            "type": "object",
            "description": "An audit/v1 artifact."
          }
        }
      }
    },
    {
      "name": "generate_test_plan",
      "description": "Generate a deterministic test plan from an audit graph.",
      "outputArtifact": {
        "schemaVersion": "plan/v1",
        "schemaPath": "schemas/plan-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audit"
        ],
        "properties": {
          "audit": {
            "type": "object",
            "description": "An audit/v1 artifact."
          },
          "itemId": {
            "type": "string",
            "description": "Optional stable plan item id to select."
          }
        }
      }
    },
    {
      "name": "explain_target",
      "description": "Explain one audit target by stable target id.",
      "outputArtifact": {
        "schemaVersion": "target-explanation/v1",
        "schemaPath": "schemas/target-explanation-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audit",
          "targetId"
        ],
        "properties": {
          "audit": {
            "type": "object",
            "description": "An audit/v1 artifact."
          },
          "targetId": {
            "type": "string",
            "description": "Stable audit target id."
          }
        }
      }
    },
    {
      "name": "rank_test_candidates",
      "description": "Rank testable audit targets by risk reduction and maintenance cost.",
      "outputArtifact": {
        "schemaVersion": "candidate-ranking/v1",
        "schemaPath": "schemas/candidate-ranking-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audit"
        ],
        "properties": {
          "audit": {
            "type": "object",
            "description": "An audit/v1 artifact."
          }
        }
      }
    },
    {
      "name": "analyze_test_placement",
      "description": "Analyze existing test placement from an audit graph and return advisory placement findings.",
      "outputArtifact": {
        "schemaVersion": "test-placement-findings/v1",
        "schemaPath": "schemas/test-placement-findings-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audit"
        ],
        "properties": {
          "audit": {
            "type": "object",
            "description": "An audit/v1 artifact."
          },
          "owner": {
            "type": "string",
            "description": "Optional owner label for the audited project. Defaults to audit.profile.root."
          }
        }
      }
    },
    {
      "name": "generate_selected_test",
      "description": "Return a structured deferred result until native test generation is enabled.",
      "outputArtifact": {
        "schemaVersion": "generation-deferred/v1",
        "schemaPath": "schemas/generation-deferred-v1.schema.json"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "planItemId"
        ],
        "properties": {
          "planItemId": {
            "type": "string",
            "description": "Stable plan item id selected for future generation."
          }
        }
      }
    }
  ]
}
